{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urlow",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "run_worker_first": [
      "/*",
      "!/_nuxt/*",
      "!/favicon.ico",
      "!/robots.txt"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a810c4931f224ad4ae3a796a4490bba4"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SHORT_URL_CACHE",
      "id": "9da24c21c7f4406fbb97e9abc424e22b"
    }
  ]
}
